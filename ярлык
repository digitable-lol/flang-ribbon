#
# Ярлыки на команды репозитория. Точка входа — здесь, а не в make.
#
# ── Зачем ────────────────────────────────────────────────────────────────────
# Ярлык — это имя, за которым стоит строка команды. Строки эти лежали в
# `Makefile`; make не делал при этом ничего сверх подстановки строки — ни одной
# зависимости между целями, ни одного правила по времени файла, только `.PHONY`.
# Приём взят у самого языка (его `ярлык` и `ярлыки.flang`): тонкая оболочка на
# sh плюс программа на flang.
#
# Список ярлыков лежит в `ярлыки.flang` — это ПРОГРАММА, а не файл настроек:
# имена и строки проверены типами, у разборных функций есть примеры. Здесь, в
# оболочке, списка НЕТ ни одной строкой — она только спрашивает двоичный и
# запускает ответ.
#
#   ./ярлык                  весь список
#   ./ярлык проверка         выполнить ярлык
#
# ── Почему оболочка, а не сам flang ─────────────────────────────────────────
# Те же четыре причины, что названы в дереве языка: у `flang io` нет способа
# принять довод; хозяин планов копит вывод потомка и отдаёт его в конце одной
# строкой JSON; экрана у него нет вовсе; код возврата потомка до него не
# доезжает. Ярлыку нужно обратное — живой вывод и настоящий код возврата.
#
# ── Компилятор — внешнее условие, а не забота оболочки ──────────────────────
# В дереве языка первый ярлык не может быть на flang: двоичный там ещё нужно
# собрать. Здесь такой развязки не нужно. Компилятор берётся, по порядку, из
# $FLANG, из $FLANG_HOME/bootstrap/flang или с PATH; нет ни одного — оболочка
# говорит об этом и уходит кодом 3, а не собирает молча чужое дерево.
#
# ИМЕНА ПЕРЕМЕННЫХ ЗДЕСЬ ЛАТИНИЦЕЙ: ни dash, ни bash не принимают кириллицу в
# именах переменных.

set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT"

TABLE=ярлыки.flang

err() { printf '%s\n' "$*" >&2; }

if [ -z "${FLANG:-}" ]; then
  if [ -n "${FLANG_HOME:-}" ]; then FLANG=$FLANG_HOME/bootstrap/flang; else FLANG=flang; fi
fi
export FLANG

if ! command -v "$FLANG" >/dev/null 2>&1; then
  err "компилятора flang нет: «$FLANG» не найден."
  err ""
  err "Он — один двоичный файл, которому нужен только cc:"
  err "  brew install flang | asdf plugin add flang | make -C <клон flang>/bootstrap"
  err "Указать вручную: FLANG=путь/к/flang ./ярлык …  или  FLANG_HOME=клон/flang"
  exit 3
fi

# Ответ `flang run` — значение в виде JSON, то есть строка в кавычках. Снимаем
# кавычки, разворачиваем \" и \n. Обратная косая внутри команды сломала бы это
# молча, поэтому такая строка отвергается вслух.
unjson() {
  raw=$1
  case $raw in
    '"'*'"') ;;
    *) err "двоичный ответил не строкой: $raw"; exit 3 ;;
  esac
  body=${raw#\"}
  body=${body%\"}
  if printf '%s' "$body" | grep -q '\\\\'; then
    err "в строке ярлыка есть обратная косая — так писать нельзя"
    exit 3
  fi
  printf '%b' "$(printf '%s' "$body" | sed 's/\\"/"/g')"
}

ask() { "$FLANG" run "$TABLE" --function "$1" ${2:+--args} ${2:+"$2"}; }

listing() {
  printf '%s\n\n' "ярлыки этого дерева (список — в $TABLE):"
  unjson "$(ask '«Перечень»')"
  printf '\n\n%s\n' "звать: ./ярлык <имя>"
}

name=${1:-}
[ $# -gt 0 ] && shift

case $name in
  "") listing; exit 0 ;;
  --help|-h|help) listing; exit 0 ;;
  *\"*|*\\*) err "в имени ярлыка не бывает кавычек и обратных косых: $name"; exit 2 ;;
esac

command_line=$(unjson "$(ask '«Команда ярлыка»' "{\"ярлык\":\"$name\"}")")

if [ -z "$command_line" ]; then
  err "ярлыка «$name» нет. Вот какие есть:"
  err ""
  listing >&2
  exit 2
fi

# Доводов ярлыки этого дерева не принимают: строка команды кончается `done`
# или `&&`, и дописанный к ней довод стал бы синтаксической ошибкой sh, а не
# доводом. Сказать об этом прямо дешевле, чем разбираться в чужой ошибке.
if [ $# -gt 0 ]; then
  err "ярлык «$name» доводов не принимает: $*"
  exit 2
fi

exec sh -c "$command_line" "ярлык:$name"
